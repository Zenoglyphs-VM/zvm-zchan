# No node is built into this repository: everything it talks to is named here.
# These are a local zvm-devnet's, at its default address
# (https://github.com/Zenoglyphs-VM/zvm-devnet).
# Copy this file to .env and change what you need; .env is kept out of git.

# --- The page (read at build time)
# A ZVM node's base URL: its JSON-RPC is at /rpc and its read API at /api.
VITE_ZVM_NODE=http://localhost:47080/zvm
# Where the explorer, Glyphswap and the other apps are, for links.
VITE_GATEWAY=http://localhost:47080

# --- Scripts (deploy, check, the live browser check). Node does not read this
# file by itself: `node --env-file=.env scripts/...`, or export them.
ZVM_RPC=http://localhost:47080/zvm/rpc
ZVM_NODE=http://localhost:47080/zvm
